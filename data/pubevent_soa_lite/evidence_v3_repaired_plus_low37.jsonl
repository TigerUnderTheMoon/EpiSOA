{"evidence_id": "ev-00611", "event_id": "E025", "source": "public_social", "platform": "m.toutiao.com", "publish_time": null, "url": "https://m.toutiao.com/article/7387833372795486759/", "text": "重塑信任:医患关系的隐私红线\n在现代社会,医院不仅是治疗疾病的场所,更是人们对生命与健康寄托的地方。然而,最近上海东方医院孙贵新医生涉嫌泄露患者隐私的事件,引发了广泛关注和深思。医患关系作为社会最为敏", "stakeholder_hint": null, "stance_hint": null, "temporal_stage": null, "traceable": true, "source_type": "social_media", "legacy_text": "重塑信任:医患关系的隐私红线\n在现代社会,医院不仅是治疗疾病的场所,更是人们对生命与健康寄托的地方。然而,最近上海东方医院孙贵新医生涉嫌泄露患者隐私的事件,引发了广泛关注和深思。医患关系作为社会最为敏", "fulltext_backfill_status": "ok", "fulltext_chars": 4, "fulltext_fetched_at": "2026-05-25T17:57:26.672576+00:00", "fulltext_sha256": "e87a25b673d1606ecc9f0c39b7258ca5ec0491db2c212443f2f7bc0525e7fea2", "fulltext_final_url": "https://www.toutiao.com/article/7387833372795486759/?&source=m_redirect", "fulltext_content_type": "text/html; charset=utf-8", "unusable_fulltext": "今日头条", "usable_clean_status": "repaired_from_legacy_text", "usable_clean_reason": "too_short", "usable_text_chars": 100}
