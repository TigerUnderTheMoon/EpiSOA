{"evidence_id": "ev-00900", "event_id": "E037", "source": "public_social", "platform": "www.toutiao.com", "publish_time": null, "url": "https://www.toutiao.com/article/7223769255425327677/", "text": "北京长峰医院火灾是一场引起人们高度关注的重大灾难事件,需要予以高度重视和深入分析。首先,作为一家医院,其防火措施应该是严密的,但由于某些原因,火灾还是发生了,造成了多名患者的伤亡。", "stakeholder_hint": null, "stance_hint": null, "temporal_stage": null, "traceable": true, "source_type": "social_media", "legacy_text": "北京长峰医院火灾是一场引起人们高度关注的重大灾难事件,需要予以高度重视和深入分析。首先,作为一家医院,其防火措施应该是严密的,但由于某些原因,火灾还是发生了,造成了多名患者的伤亡。", "fulltext_backfill_status": "ok", "fulltext_chars": 4, "fulltext_fetched_at": "2026-05-25T17:57:26.672576+00:00", "fulltext_sha256": "e87a25b673d1606ecc9f0c39b7258ca5ec0491db2c212443f2f7bc0525e7fea2", "fulltext_final_url": "https://www.toutiao.com/article/7223769255425327677/", "fulltext_content_type": "text/html; charset=utf-8", "unusable_fulltext": "今日头条", "usable_clean_status": "repaired_from_legacy_text", "usable_clean_reason": "too_short", "usable_text_chars": 90}
